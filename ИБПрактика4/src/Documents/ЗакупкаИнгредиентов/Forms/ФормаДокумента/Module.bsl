&НаСервере
Функция СоставЧекаНоменклатураПриИзмененииНаСервере(Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КофеИНапитки.ЦенаПродажи КАК ЦенаПродажи
		|ИЗ
		|	Справочник.КофеИНапитки КАК КофеИНапитки
		|ГДЕ
		|	КофеИНапитки.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.ЦенаПродажи;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаКлиенте
Процедура СоставЧекаНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Состав.ТекущиеДанные;
	
	ТекущаяСтрока.Цена = СоставЧекаНоменклатураПриИзмененииНаСервере(ТекущаяСтрока.Товар);
КонецПроцедуры

&НаКлиенте
Процедура СоставЧекаКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Состав.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	
	Объект.Сумма =  Объект.Состав.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура СоставЧекаЦенаПриИзменении(Элемент)
		ТекущаяСтрока = Элементы.Состав.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Цена * ТекущаяСтрока.Количество;
	
	Объект.Сумма =  Объект.Состав.Итог("Сумма");

КонецПроцедуры
